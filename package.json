{
  "name": "@dolusoft/gecko-cli",
  "version": "0.1.0",
  "description": "gecko: the desktop CLI of the Gecko web terminal, and a development hub that implements the hub contract of the desktop CLI specification.",
  "private": false,
  "type": "module",
  "bin": {
    "gecko": "./bin/gecko.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    "./dev-hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    },
    "./tab-client": {
      "types": "./dist/tab/index.d.ts",
      "default": "./dist/tab/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolusoft/gecko-cli.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:args": "node scripts/args-matrix.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dolusoft/command-protocol": "^1.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@dolusoft/command-console-core": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  }
}
